function renderBudget() {
  const tb = totalBudget();
  const ts = totalSpent();
  const tr = tb - ts;
  const pct = tb > 0 ? (ts/tb*100) : 0;
  const ppCount = periods.length;
  const avg = ppCount > 0 ? ts/ppCount : 0;

  // KPIs
  document.getElementById('kpi-total-budget').textContent = fmt(tb);
  document.getElementById('kpi-total-spent').textContent  = fmt(ts);
  document.getElementById('kpi-remaining').textContent    = fmt(tr);
  document.getElementById('kpi-pct').textContent          = pct.toFixed(1)+'%';
  document.getElementById('kpi-avg').textContent          = fmt(avg);
  document.getElementById('kpi-spent-sub').textContent    = 'Across '+ppCount+' pay periods';
  document.getElementById('kpi-remain-sub').textContent   = tr > 0 ? 'Available to spend' : 'OVER BUDGET';
  document.getElementById('kpi-pct-sub').textContent      = ppCount+' pay periods recorded';
  document.getElementById('kpi-avg-sub').textContent      = 'Per pay period average';
  document.getElementById('kpi-budget-bar').style.width   = '100%';
  document.getElementById('kpi-spent-bar').style.width    = Math.min(100,pct)+'%';
  document.getElementById('kpi-remain-bar').style.width   = Math.min(100,(tr/tb)*100)+'%';
  document.getElementById('kpi-pct-bar').style.width      = Math.min(100,pct)+'%';

  // Alerts
  let alerts = '';
  Object.keys(CATS).forEach(code=>{
    const rem = catBudget(code) - catSpent(code);
    const bud = catBudget(code);
    const pctUsed = bud > 0 ? catSpent(code)/bud*100 : 0;
    if(rem < 0) alerts += `<div class="alert danger"><span>⚠</span> Code ${code} is OVER BUDGET by ${fmt(Math.abs(rem))}. Timesheets will be rejected.</div>`;
    else if(pctUsed > 90) alerts += `<div class="alert warn"><span>⚠</span> Code ${code} balance is low — ${fmt(rem)} remaining (${pctUsed.toFixed(0)}% used). Consider switching to Code 320.</div>`;
  });
  document.getElementById('budget-alerts').innerHTML = alerts;

  // Category bars
  const BAR_COLORS = {'310':'#3b82f6','320':'#10b981','331':'#f59e0b','ite':'#ef4444'};
  const BAR_BADGES = {'310':'b310','320':'b320','331':'b331','ite':'bite'};
  let barsHtml = '';
  Object.entries(CATS).forEach(([code,cat])=>{
    const bud   = catBudget(code);
    const spent = catSpent(code);
    const rem   = bud - spent;
    const pctU  = bud > 0 ? Math.min(100,(spent/bud)*100) : 0;
    const remColor = rem < 0 ? 'color:var(--red)' : rem < bud*0.1 ? 'color:var(--orange)' : '';
    barsHtml += `
      <div class="cat-bar-section">
        <div class="cat-top">
          <div class="cat-name"><span class="badge ${BAR_BADGES[code]}">${code.toUpperCase()}</span>${cat.label}</div>
          <div class="cat-nums"><span>Budget: <strong>${fmt(bud)}</strong></span><span>Spent: <strong>${fmt(spent)}</strong></span></div>
        </div>
        <div class="cat-track"><div class="cat-fill" style="width:${pctU}%;background:${BAR_COLORS[code]};"></div></div>
        <div class="cat-foot"><span>${pctU.toFixed(1)}% used</span><span style="${remColor}">${fmt(rem)} remaining</span></div>
      </div>`;
  });
  document.getElementById('cat-bars').innerHTML = barsHtml;

  // NextStep
  const nsSpent = nsFeeSpent();
  const nsBudget = catBudget('331');
  const nsMos = Math.round(nsSpent / settings.nsFee);
  document.getElementById('ns-fee-display').textContent  = fmt(settings.nsFee)+'/mo';
  document.getElementById('ns-months-paid').textContent  = nsMos+' months paid · '+(Math.floor(nsBudget/settings.nsFee)-nsMos)+' remaining';
  document.getElementById('ns-summary').textContent      = fmt(nsSpent)+' paid · '+fmt(Math.max(0,nsBudget-nsSpent))+' budget left';

  // Adjustments
  const adjRows = adjs.map(a=>`
    <tr>
      <td class="mono">${fmtDateUS(a.date)}</td>
      <td><span class="badge ${a.code==='310'?'b310':a.code==='320'?'b320':a.code==='331'?'b331':'bite'}">${a.code.toUpperCase()}</span></td>
      <td class="${a.amt>=0?'green':'red'}">${a.amt>=0?'+':''}${fmt(a.amt)}</td>
      <td>${a.note||''}</td>
      <td><button class="btn btn-ghost btn-sm" onclick="deleteAdj('${a.id}')">✕</button></td>
    </tr>`).join('');
  document.getElementById('adj-tbody').innerHTML = adjRows || '<tr><td colspan="5" style="color:var(--text3);text-align:center;padding:16px;">No adjustments yet</td></tr>';
}

