function renderCal() {
  const MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const y=calDate.getFullYear(), m=calDate.getMonth();
  document.getElementById('cal-lbl').textContent=MONTHS[m]+' '+y;
  const first=new Date(y,m,1).getDay(), days=new Date(y,m+1,0).getDate();
  const DOWS=['Su','Mo','Tu','We','Th','Fr','Sa'];
  let html=DOWS.map(d=>`<div class="mini-cal-dow">${d}</div>`).join('');
  for(let i=0;i<first;i++) html+=`<div class="mini-cal-day empty"></div>`;
  for(let d=1;d<=days;d++){
    const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
    const isSel=iso===selectedDate, isToday=iso===todayStr();
    html+=`<div class="mini-cal-day${isSel?' sel':isToday?' today':''}" onclick="pickDay('${iso}')">${d}</div>`;
  }
  document.getElementById('cal-grid').innerHTML=html;
}

