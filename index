<script>
// ══════════════════════════════════════
// CONSTANTS & CONFIG
// ══════════════════════════════════════
const TAX_RATE   = 0.2064;
const TODAY      = new Date(2026, 4, 22); // May 22 2026
const BUDGET_END = new Date(2026, 11, 1); // 11/30/26 end

const CATS = {
  '310': { label:'Respite Services',                    color:'#3b82f6', origBudget:14452.80 },
  '320': { label:'Community Living Support',            color:'#10b981', origBudget:200631.60 },
  '331': { label:'Community Integration (NextStep)',    color:'#f59e0b', origBudget:9984.00 },
  'ite': { label:'Individual Training & Education',     color:'#ef4444', origBudget:500.00 }
};

const EMPLOYEES = {
  cor: { name:'Cordelia',  rates:[{from:'2025-12-01',reg:31.11},{from:'2026-04-16',reg:33}], active:true,  startDate:'2025-12-01' },
  mav: { name:'Maverick',  rates:[{from:'2025-12-01',reg:31.11},{from:'2026-01-16',reg:33}], active:true,  startDate:'2025-12-01' },
  raf: { name:'Rafi',      rates:[{from:'2026-02-15',reg:28}],                                active:true,  startDate:'2026-02-15' },
  nic: { name:'Nicholas',  rates:[{from:'2025-12-01',reg:31.11}],                             active:false, startDate:'2025-12-01', endDate:'2026-01-31' }
};

// Get rate for employee at a given date
function getRate(emp, dateStr) {
  const empl = EMPLOYEES[emp];
  if (!empl) return { reg:0, ot:0, ot2:0 };
  const applicable = empl.rates.filter(r => r.from <= dateStr);
  const r = applicable.length ? applicable[applicable.length-1] : empl.rates[0];
  return { reg: r.reg, ot: +(r.reg * 1.5).toFixed(2), ot2: +(r.reg * 2).toFixed(2) };
}

// ══════════════════════════════════════
// SEED DATA — all 12 pay periods
