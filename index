let clWeekOffset = 0;
function clNavWeek(dir) {
  if(dir===0) clWeekOffset=0; else clWeekOffset+=dir;
  renderClockLog();
}

function renderClockLog() {
  const base = weekStart(TODAY);
  base.setDate(base.getDate() + clWeekOffset*7);
  const days = Array.from({length:7},(_,i)=>{ const d=new Date(base); d.setDate(d.getDate()+i); return d; });
  const DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const empKeys = ['cor','mav','raf'];

  document.getElementById('cl-week-label').textContent =
    'Week of '+DOW[0]+' '+MON[base.getMonth()]+' '+base.getDate()+', '+base.getFullYear();

  let warnings = [];
  const weekHrs = {};
  empKeys.forEach(e=>{ weekHrs[e] = days.map(d=>timesheet[isoFromDate(d)]?.[e]||0); });

  // Build grid
  let gridHtml = `<div class="clk-grid">
    <div class="clk-hdr">Date</div>
    ${empKeys.map(e=>`<div class="clk-hdr">${EMPLOYEES[e].name}</div>`).join('')}
    <div class="clk-hdr">Day Total</div>`;

  days.forEach((d,i)=>{
    const iso = isoFromDate(d);
    const isToday = iso === todayStr();
    gridHtml += `<div class="clk-cell" style="${isToday?'font-weight:700;color:var(--blue);':''}">${DOW[i]} ${d.getDate()}/${d.getMonth()+1}</div>`;
    let dayTotal = 0;
    empKeys.forEach(e=>{
      const h = weekHrs[e][i];
      dayTotal += h;
      let cls = 'clk-cell';
      let label = h > 0 ? h.toFixed(1)+' hrs' : '<span style="color:var(--text3)">—</span>';
      if(h > 12) { cls += ' ot2'; label = h.toFixed(1)+' hrs 🔴 2×'; }
      else if(h > 8) { cls += ' ot'; label = h.toFixed(1)+' hrs ⚠'; }
      gridHtml += `<div class="${cls}">${label}</div>`;
    });
    gridHtml += `<div class="clk-cell" style="color:var(--text3);">${dayTotal>0?dayTotal.toFixed(1)+' hrs':'—'}</div>`;
  });

  // Week totals row
  gridHtml += `<div class="clk-cell clk-tot" style="font-weight:700;">Week Total</div>`;
  empKeys.forEach(e=>{
    const wk = weekHrs[e].reduce((s,h)=>s+h,0);
    const cls = wk > 40 ? 'ot' : '';
    const warn = wk > 40 ? ' ⚠ OT' : '';
    if(wk > 40) warnings.push(`${EMPLOYEES[e].name}: ${wk.toFixed(1)} hrs this week — weekly OT applies`);
    gridHtml += `<div class="clk-cell clk-tot ${cls}">${wk>0?wk.toFixed(1)+' hrs'+warn:'—'}</div>`;
  });
  const dayTotals = days.map((_,i)=>empKeys.reduce((s,e)=>s+weekHrs[e][i],0));
  gridHtml += `<div class="clk-cell clk-tot">${dayTotals.reduce((s,h)=>s+h,0).toFixed(1)} hrs</div></div>`;

  document.getElementById('cl-grid-wrap').innerHTML = gridHtml;

  const warnEl = document.getElementById('cl-warning');
  if(warnings.length) {
    warnEl.style.display='block';
    warnEl.innerHTML = '⚠ '+warnings.join(' · ');
  } else { warnEl.style.display='none'; }

  // OT Summary table
  const summRows = empKeys.map(e=>{
    const dailyArr = weekHrs[e];
    let reg=0,ot15=0,ot2=0;
    dailyArr.forEach(h=>{ reg+=Math.min(h,8); ot15+=Math.max(0,Math.min(h,12)-8); ot2+=Math.max(0,h-12); });
    const rate  = getRate(e, isoFromDate(days[0]));
    const gross = reg*rate.reg + ot15*rate.ot + ot2*rate.ot2;
    const total = reg+ot15+ot2;
    return `<tr>
      <td><strong>${EMPLOYEES[e].name}</strong></td>
      <td class="mono">${reg.toFixed(1)}</td>
      <td class="${ot15>0?'amber':'mono'}">${ot15.toFixed(1)}</td>
      <td class="${ot2>0?'red':'mono'}">${ot2.toFixed(1)}</td>
      <td class="mono"><strong>${total.toFixed(1)}</strong></td>
      <td class="green">${fmt(gross)}</td>
    </tr>`;
  }).join('');
  document.getElementById('cl-summary-tbody').innerHTML = summRows;
}

// ══════════════════════════════════════
// RENDER PROJECTION
// ══════════════════════════════════════
function renderProjection() {
  const tb = totalBudget();
  const ts = totalSpent();
  const tr = tb - ts;
  const ppCount = periods.length;
  const avg = ppCount > 0 ? ts/ppCount : 0;

  // Days remaining
  const daysLeft = Math.max(0, Math.round((BUDGET_END - TODAY)/86400000));
  const ppLeft   = Math.round(daysLeft/15); // approx 15-day periods
  const projSpend = ppLeft * avg;
  const projEnd  = ts + projSpend;
  const projRem  = tb - projEnd;

  document.getElementById('proj-body').innerHTML = `
    <div class="proj-item"><div class="proj-lbl">Pay periods recorded</div><div class="proj-val">${ppCount}</div></div>
    <div class="proj-item"><div class="proj-lbl">Average spend per period</div><div class="proj-val">${fmt(avg)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Days remaining in budget year</div><div class="proj-val">${daysLeft} days</div></div>
    <div class="proj-item"><div class="proj-lbl">Estimated periods remaining</div><div class="proj-val">~${ppLeft} periods</div></div>
    <div class="proj-item"><div class="proj-lbl">Projected additional spend</div><div class="proj-val">${fmt(projSpend)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Projected total spend</div><div class="proj-val ${projEnd>tb?'red':'green'}">${fmt(projEnd)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Projected remaining at year end</div><div class="proj-val ${projRem<0?'red':'green'}">${fmt(projRem)}</div></div>
  `;

  // Code projections
  let codeHtml = '';
  Object.entries(CATS).forEach(([code,cat])=>{
    const bud   = catBudget(code);
    const spent = catSpent(code);
    const rem   = bud-spent;
    const pct   = bud>0 ? (spent/bud*100).toFixed(1) : '0.0';
    codeHtml += `<div class="proj-item">
      <div class="proj-lbl"><span class="badge ${'b'+code.replace('ite','ite')}" style="margin-right:6px;">${code.toUpperCase()}</span>${cat.label}</div>
      <div class="proj-val ${rem<0?'red':rem<bud*.1?'amber':'green'}">${fmt(rem)}</div>
    </div>`;
  });
  document.getElementById('proj-codes').innerHTML = codeHtml;

  // Running table
  let running = 0;
  const projRows = periods.map(p=>{
    const total = (p.gross||0)+(p.tax||0);
    running += total;
    return `<tr>
      <td class="mono">${p.id}</td>
      <td>${p.label}</td>
      <td><span class="badge b${p.code}">${(p.code||'').toUpperCase()}</span></td>
      <td class="mono">${fmt(total)}</td>
      <td class="mono">${fmt(running)}</td>
      <td class="mono ${(tb-running)<0?'red':'green'}">${fmt(tb-running)}</td>
    </tr>`;
  }).join('');
  document.getElementById('proj-tbody').innerHTML = projRows;
}

