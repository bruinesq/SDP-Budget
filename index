// EXPORT / IMPORT
// ══════════════════════════════════════
function exportData() {
  const payload = { version:1, exportedAt:new Date().toISOString(), periods, adjs, settings, timesheet };
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  const stamp=todayStr();
  a.href=url; a.download='sdp_backup_'+stamp+'.json';
  document.body.appendChild(a); a.click();
  document.body.removeChild(a); URL.revokeObjectURL(url);
  showToast('Backup saved ✓');
}
function importData(event) {
  const file=event.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=function(e){
    try {
      const data=JSON.parse(e.target.result);
      if(!data.periods) { showToast('Invalid backup file.'); return; }
      if(!confirm('Replace ALL current data with this backup?')) return;
      periods=data.periods||SEED_PERIODS;
      adjs=data.adjs||SEED_ADJS;
      settings=data.settings||SEED_SETTINGS;
      timesheet=data.timesheet||{};
      saveS('sdp_periods_v1',periods);
      saveS('sdp_adjs_v1',adjs);
      saveS('sdp_settings_v1',settings);
      saveS('sdp_timesheet_v1',timesheet);
      switchTab(currentTab);
      showToast('Data restored ✓');
    } catch(err) { showToast('Could not read backup file.'); }
    event.target.value='';
  };
  reader.readAsText(file);
}

