// ══════════════════════════════════════
// HELPERS
// ══════════════════════════════════════
function fmt(n) {
  const abs = Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  return (n < 0 ? '-$' : '$') + abs;
}
function fmtH(h) { return h > 0 ? h.toFixed(1)+' hrs' : '—'; }
function todayStr() {
  return TODAY.getFullYear()+'-'+String(TODAY.getMonth()+1).padStart(2,'0')+'-'+String(TODAY.getDate()).padStart(2,'0');
}
function dateUStoISO(s) { if(!s||!s.includes('/')) return s; const [m,d,y]=s.split('/'); return y+'-'+m.padStart(2,'0')+'-'+d.padStart(2,'0'); }
function fmtDateUS(iso) { if(!iso) return '—'; const [y,m,d]=iso.split('-'); return m+'/'+d+'/'+y; }
function weekStart(d) {
  const dt = new Date(d); dt.setDate(dt.getDate() - dt.getDay()); // Sunday
  return dt;
}
function isoFromDate(d) {
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}

// ── Budget calculations ──
function catBudget(code) {
  let b = CATS[code] ? CATS[code].origBudget : 0;
  adjs.filter(a=>a.code===code).forEach(a=>b+=a.amt);
  return b;
}
function catSpent(code) {
  return periods.filter(p=>p.code===code).reduce((s,p)=>{
    const total = (p.gross||0) + (p.tax||0);
    return s + total;
  }, 0);
}
function totalBudget()  { return Object.keys(CATS).reduce((s,c)=>s+catBudget(c),0); }
function totalSpent()   { return periods.reduce((s,p)=>s+(p.gross||0)+(p.tax||0),0); }
function nsFeeSpent()   {
  // Count months from nsFeeStart through today
  const start = new Date(settings.nsFeeStart);
  let months = (TODAY.getFullYear()-start.getFullYear())*12 + (TODAY.getMonth()-start.getMonth()) + 1;
  return months * settings.nsFee;
}

// OT calc (Sun–Sat week, CA rules)
function calcHoursGross(emp, dailyHrs) {
  const rate = getRate(emp, todayStr());
  let totalReg=0, totalOt15=0, totalOt2=0;
  let weeklyHrs=0;
  dailyHrs.forEach(h=>{
    // Daily OT
    const dailyReg  = Math.min(h, 8);
    const dailyOt15 = Math.max(0, Math.min(h,12) - 8);
    const dailyOt2  = Math.max(0, h - 12);
    totalReg  += dailyReg;
    totalOt15 += dailyOt15;
    totalOt2  += dailyOt2;
    weeklyHrs += h;
  });
  // Weekly OT: >40 hrs/week (already counted daily OT)
  // (Premier uses daily OT; weekly not double-counted)
  const gross = totalReg*rate.reg + totalOt15*rate.ot + totalOt2*rate.ot2;
  return { reg:+totalReg.toFixed(2), ot15:+totalOt15.toFixed(2), ot2:+totalOt2.toFixed(2), gross:+gross.toFixed(2), total:+(totalReg+totalOt15+totalOt2).toFixed(2) };
}

