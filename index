function openKp(title, showDesc, showCode, showDate, showSign) {
  kpValue = '';
  document.getElementById('kp-title').textContent = title;
  document.getElementById('kp-desc-wrap').style.display  = showDesc  ? 'block' : 'none';
  document.getElementById('kp-code-wrap').style.display  = showCode  ? 'flex'  : 'none';
  document.getElementById('kp-date-wrap').style.display  = showDate  ? 'flex'  : 'none';
  document.getElementById('kp-sign-wrap').style.display  = showSign  ? 'flex'  : 'none';
  if(showDate) {
    kpDate = todayStr(); selectedDate = kpDate;
    document.getElementById('kp-date-lbl').textContent = 'Date: '+fmtDateUS(kpDate);
  }
  if(showCode) selectCode(kpCode);
  if(showSign) setKpSign(1);
  updateKpDisplay();
  document.getElementById('kp-overlay').classList.add('open');
}

function closeKp() { document.getElementById('kp-overlay').classList.remove('open'); }
function handleKpBg(e) { if(e.target===document.getElementById('kp-overlay')) closeKp(); }

function selectCode(c) {
  kpCode = c;
  ['310','320','331','ite'].forEach(x=>{
    const el = document.getElementById('kpcode-'+x);
    if(el) el.classList.toggle('sel', x===c);
  });
}

function setKpSign(s) {
  kpSign = s;
  document.getElementById('kp-sign-pos').classList.toggle('pos', s===1);
  document.getElementById('kp-sign-neg').classList.toggle('neg', s===-1);
  document.getElementById('kp-sign-pos').style.opacity = s===1?'1':'0.5';
  document.getElementById('kp-sign-neg').style.opacity = s===-1?'1':'0.5';
  updateKpDisplay();
}

function kpKey(k) {
  if(k==='back') { kpValue=kpValue.slice(0,-1); }
  else if(k==='.') { if(!kpValue.includes('.')) kpValue+='.'; }
  else { if(kpValue.length>=8) return; kpValue+=k; }
  updateKpDisplay();
}

function updateKpDisplay() {
  const n = parseFloat(kpValue)||0;
  const disp = kpValue==='' ? '0' : kpValue;
  document.getElementById('kp-box-main-val').textContent = disp;
  let sub = '';
  if(kpMode==='adj') sub = 'Code '+kpCode+(kpSign===1?' · Increase':' · Decrease');
  if(kpMode==='ts')  sub = EMPLOYEES[kpEmp]?.name+' hrs';
  if(kpMode==='nsfee') sub = '/month · Code 331';
  if(kpMode==='rec') sub = kpField.toUpperCase()+' from statement';
  document.getElementById('kp-box-main-sub').textContent = sub;
}

function kpConfirm() {
  const val = parseFloat(kpValue);
  if(isNaN(val) || val < 0) { showToast('Please enter a valid amount.'); return; }

  if(kpMode==='adj') {
    const note = document.getElementById('kp-desc')?.value?.trim()||'';
    const newAdj = { id:'adj'+(nextAdjId++), date:kpDate, code:kpCode, amt:+(val*kpSign).toFixed(2), note };
    adjs.push(newAdj);
    saveS('sdp_adjs_v1', adjs);
    closeKp();
    renderBudget();
    showToast('Adjustment added ✓');
  }
  else if(kpMode==='nsfee') {
    settings.nsFee = +val.toFixed(2);
    saveS('sdp_settings_v1', settings);
    closeKp();
    renderBudget();
    showToast('NextStep fee updated to '+fmt(settings.nsFee)+'/mo ✓');
  }
  else if(kpMode==='ts') {
    if(!timesheet[kpDate]) timesheet[kpDate]={};
    timesheet[kpDate][kpEmp] = +val.toFixed(2);
    saveS('sdp_timesheet_v1', timesheet);
    closeKp();
    renderTimesheet();
    if(currentTab==='clocklog') renderClockLog();
    showToast('Hours saved: '+val+' hrs for '+EMPLOYEES[kpEmp].name+' ✓');
  }
  else if(kpMode==='rec') {
    recVals[kpField] = +val.toFixed(2);
    document.getElementById('rec-'+kpField).textContent = fmt(val);
    closeKp();
  }
  else if(kpMode==='ppamt') {
    if(kpField==='gross') {
      window._ppGross = +val.toFixed(2);
      document.getElementById('pp-gross').textContent = fmt(val);
      // auto-calc tax
      const tax = +(val * TAX_RATE).toFixed(2);
      window._ppTax   = tax;
      document.getElementById('pp-tax').textContent  = fmt(tax);
      document.getElementById('pp-total').textContent = fmt(val+tax);
    } else {
      window._ppTax = +val.toFixed(2);
      document.getElementById('pp-tax').textContent   = fmt(val);
      const g = window._ppGross||0;
      document.getElementById('pp-total').textContent = fmt(g+val);
    }
    closeKp();
  }
  else if(kpMode==='pphrs') {
    if(!window._ppHrs) window._ppHrs = {};
    window._ppHrs[kpField] = +val.toFixed(2);
    document.getElementById('pp-hrs-'+kpField).textContent = val.toFixed(1)+' hrs';
    closeKp();
  }
  else if(kpMode==='recKp') {
    recVals[kpField] = +val.toFixed(2);
    document.getElementById('rec-'+kpField).textContent = fmt(val);
    closeKp();
  }
}

