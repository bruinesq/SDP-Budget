<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>SDP Budget Tracker</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;600;700;800&display=swap');

:root {
  --blue:      #0077b6;
  --blue-dark: #005f92;
  --blue-deep: #003f63;
  --yellow:    #f5c842;
  --yellow-lt: #fff8dc;
  --yellow-dk: #d4a800;
  --gray-bdr:  #dde3ec;
  --text1:     #0d1b2a;
  --text2:     #3a4a5c;
  --text3:     #6b7c93;
  --green:     #0d9e6e;
  --red:       #d63b3b;
  --orange:    #e07b00;
  --card:      rgba(255,255,255,0.88);
  --card-bdr:  rgba(255,255,255,0.7);
}

* { box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
html,body { height:100%; }
body {
  font-family:'Syne',sans-serif;
  background:linear-gradient(170deg,#003f63 0%,#0077b6 18%,#c8dff0 45%,#e8f4fb 65%,#f0f6fa 100%);
  background-attachment:fixed;
  color:var(--text1);
  min-height:100vh;
}

/* ─── HEADER ─── */
.hdr {
  background:var(--blue-deep);
  display:flex; align-items:center; justify-content:space-between;
  padding:0 28px; height:60px;
  box-shadow:0 2px 10px rgba(0,0,0,.25);
  position:sticky; top:0; z-index:100;
}
.hdr-left { display:flex; align-items:center; gap:14px; }
.hdr-logo {
  background:var(--yellow); color:var(--blue-deep);
  font-weight:800; font-size:15px; padding:5px 14px;
  border-radius:8px; letter-spacing:.02em;
}
.hdr-title { font-size:17px; font-weight:700; color:#fff; }
.hdr-sub { font-size:11px; color:rgba(255,255,255,.6); font-family:'DM Mono',monospace; margin-top:1px; }
.hdr-right { display:flex; align-items:center; gap:10px; }
.sync-pill {
  font-size:10px; font-family:'DM Mono',monospace;
  padding:4px 10px; border-radius:6px; border:1px solid;
}
.sync-pill.live { background:rgba(13,158,110,.2); border-color:rgba(13,158,110,.4); color:#6ee7b7; }
.sync-pill.wait { background:rgba(255,255,255,.1); border-color:rgba(255,255,255,.2); color:rgba(255,255,255,.7); }
.hdr-btn {
  background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.25);
  color:#fff; border-radius:8px; padding:5px 13px;
  font-size:18px; font-weight:900; cursor:pointer; line-height:1;
}

/* ─── TAB BAR ─── */
.tabs {
  background:var(--blue-dark);
  display:flex; padding:0 24px;
  border-bottom:2px solid var(--blue-deep);
  position:sticky; top:60px; z-index:99;
  overflow-x:auto; -webkit-overflow-scrolling:touch;
}
.tabs::-webkit-scrollbar { display:none; }
.tab {
  padding:13px 18px; font-size:11px; font-weight:700;
  color:rgba(255,255,255,.5); cursor:pointer;
  border-bottom:3px solid transparent; margin-bottom:-2px;
  letter-spacing:.06em; text-transform:uppercase;
  white-space:nowrap; transition:all .2s;
}
.tab.active { color:#fff; border-bottom-color:var(--yellow); }
.tab:hover:not(.active) { color:rgba(255,255,255,.8); }

/* ─── MAIN ─── */
.main { padding:22px 28px 40px; max-width:1280px; }
.panel { display:none; }
.panel.active { display:block; }

/* ─── CARD ─── */
.card {
  background:var(--card); border:1px solid var(--card-bdr);
  border-radius:14px; overflow:hidden;
  box-shadow:0 2px 14px rgba(0,60,100,.10);
  backdrop-filter:blur(6px);
}
.card-hdr {
  display:flex; align-items:center; justify-content:space-between;
  padding:13px 18px; border-bottom:1px solid rgba(221,227,236,.6);
  background:rgba(232,244,251,.7);
}
.card-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:var(--text2); }
.card-body { padding:16px 18px; }

/* ─── KPI ROW ─── */
.kpi-row { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:18px; }
.kpi {
  background:var(--card); border:1px solid var(--card-bdr);
  border-radius:14px; padding:15px 18px;
  box-shadow:0 2px 12px rgba(0,60,100,.08);
  backdrop-filter:blur(6px);
}
.kpi-lbl { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text3); margin-bottom:7px; }
.kpi-val { font-family:'DM Mono',monospace; font-size:25px; font-weight:500; line-height:1; }
.kpi-val.blue   { color:var(--blue); }
.kpi-val.green  { color:var(--green); }
.kpi-val.orange { color:var(--orange); }
.kpi-val.red    { color:var(--red); }
.kpi-sub { font-size:11px; color:var(--text3); margin-top:5px; font-family:'DM Mono',monospace; }
.mini-bar { background:#e4eaf2; border-radius:100px; height:5px; margin-top:8px; overflow:hidden; }
.mini-fill { height:100%; border-radius:100px; }

/* ─── GRID LAYOUTS ─── */
.g2 { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:18px; }
.g3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; margin-bottom:18px; }
.g2l { display:grid; grid-template-columns:2fr 1fr; gap:18px; margin-bottom:18px; }

/* ─── ALERT ─── */
.alert {
  display:flex; align-items:center; gap:10px;
  padding:10px 16px; border-radius:10px;
  font-size:13px; font-weight:600; margin-bottom:16px;
  backdrop-filter:blur(4px);
}
.alert.warn   { background:rgba(255,248,225,.92); border:1px solid var(--yellow); color:#7a5800; }
.alert.danger { background:rgba(253,232,232,.92); border:1px solid #f5a5a5; color:#8b1a1a; }
.alert.info   { background:rgba(219,234,254,.92); border:1px solid #93c5fd; color:#1e40af; }

/* ─── TABLE ─── */
.t-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:13px; }
thead th {
  background:rgba(232,244,251,.8); padding:9px 14px;
  text-align:left; font-size:10px; font-weight:700;
  text-transform:uppercase; letter-spacing:.08em; color:var(--text3);
  border-bottom:1px solid var(--gray-bdr); font-family:'DM Mono',monospace;
  white-space:nowrap; position:sticky; top:0;
}
tbody td { padding:10px 14px; border-bottom:1px solid rgba(240,242,245,.8); color:var(--text2); vertical-align:middle; }
tbody td.mono  { font-family:'DM Mono',monospace; color:var(--text1); }
tbody td.green { font-family:'DM Mono',monospace; color:var(--green); font-weight:700; }
tbody td.red   { font-family:'DM Mono',monospace; color:var(--red);   font-weight:700; }
tbody td.amber { font-family:'DM Mono',monospace; color:var(--orange); font-weight:700; }
tbody tr:last-child td { border-bottom:none; }
tbody tr:hover td { background:rgba(0,119,182,.04); }
.tot-row td { background:rgba(232,244,251,.8) !important; font-weight:700; border-top:2px solid var(--gray-bdr) !important; }

/* ─── BADGES ─── */
.badge { font-size:10px; font-weight:800; padding:2px 8px; border-radius:100px; font-family:'DM Mono',monospace; white-space:nowrap; }
.b310 { background:#dbeafe; color:#1e40af; }
.b320 { background:#d1fae5; color:#065f46; }
.b331 { background:#fef3c7; color:#92400e; }
.bite { background:#fee2e2; color:#991b1b; }
.locked { font-size:9px; background:rgba(107,124,147,.15); color:var(--text3); padding:2px 7px; border-radius:4px; font-family:'DM Mono',monospace; }

/* ─── BUTTONS ─── */
.btn {
  padding:8px 18px; border-radius:8px; font-size:12px; font-weight:700;
  cursor:pointer; border:none; font-family:'Syne',sans-serif;
  letter-spacing:.03em; transition:all .15s; white-space:nowrap;
}
.btn-blue   { background:var(--blue); color:#fff; }
.btn-blue:hover { background:var(--blue-dark); }
.btn-yellow { background:var(--yellow); color:var(--blue-deep); }
.btn-yellow:hover { background:var(--yellow-dk); }
.btn-ghost  { background:transparent; border:1px solid var(--gray-bdr); color:var(--text2); }
.btn-ghost:hover { background:rgba(0,0,0,.04); }
.btn-red    { background:rgba(214,59,59,.1); border:1px solid rgba(214,59,59,.3); color:var(--red); }
.btn-sm     { padding:5px 12px; font-size:11px; border-radius:6px; }

/* ─── CAT BARS ─── */
.cat-bar-section { margin-bottom:14px; }
.cat-bar-section:last-child { margin-bottom:0; }
.cat-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
.cat-name { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; color:var(--text1); }
.cat-nums { display:flex; gap:14px; font-size:12px; font-family:'DM Mono',monospace; color:var(--text3); }
.cat-nums strong { color:var(--text1); }
.cat-track { background:#dde8f0; border-radius:100px; height:11px; overflow:hidden; margin-bottom:3px; }
.cat-fill  { height:100%; border-radius:100px; }
.cat-foot  { display:flex; justify-content:space-between; font-size:11px; font-family:'DM Mono',monospace; color:var(--text3); }

/* ─── NEXTSTEP BOX ─── */
.ns-box {
  background:var(--yellow-lt); border:1px solid var(--yellow);
  border-radius:10px; padding:12px 16px;
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:12px;
}
.ns-left .ns-lbl { font-size:12px; font-weight:700; color:var(--blue-deep); }
.ns-left .ns-sub { font-size:10px; color:var(--text3); font-family:'DM Mono',monospace; margin-top:2px; }
.ns-right { text-align:right; }
.ns-val { font-family:'DM Mono',monospace; font-size:20px; font-weight:500; color:var(--blue-deep); }
.ns-sub2 { font-size:10px; color:var(--text3); font-family:'DM Mono',monospace; margin-top:2px; }

/* ─── CLOCK GRID ─── */
.clk-grid { display:grid; grid-template-columns:110px repeat(3,1fr) 110px; }
.clk-hdr  { padding:9px 12px; background:rgba(232,244,251,.8); border-bottom:1px solid var(--gray-bdr); font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--text3); font-family:'DM Mono',monospace; }
.clk-cell { padding:10px 12px; border-bottom:1px solid rgba(240,242,245,.8); font-size:13px; font-family:'DM Mono',monospace; color:var(--text1); display:flex; align-items:center; gap:6px; }
.clk-cell.ot    { color:var(--orange); font-weight:700; }
.clk-cell.ot2   { color:var(--red); font-weight:700; }
.clk-cell.muted { color:var(--text3); }
.clk-cell button { padding:3px 10px; font-size:11px; border-radius:6px; cursor:pointer; background:rgba(0,119,182,.1); border:1px solid rgba(0,119,182,.25); color:var(--blue-dark); font-weight:700; font-family:'Syne',sans-serif; }
.clk-tot  { background:rgba(232,244,251,.7) !important; font-weight:700; border-top:2px solid var(--gray-bdr) !important; }

/* ─── PROJECTION ─── */
.proj-item { display:flex; justify-content:space-between; align-items:center; padding:11px 0; border-bottom:1px solid rgba(221,227,236,.5); font-size:13px; }
.proj-item:last-child { border-bottom:none; }
.proj-lbl { color:var(--text2); }
.proj-val { font-family:'DM Mono',monospace; font-weight:600; color:var(--text1); }

/* ─── KEYPAD OVERLAY ─── */
.kp-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,.5);
  z-index:500; display:flex; align-items:flex-end; justify-content:center;
  opacity:0; pointer-events:none; transition:opacity .25s;
}
.kp-overlay.open { opacity:1; pointer-events:all; }
.kp-sheet {
  width:100%; max-width:480px;
  background:rgba(0,60,110,.97); border-radius:20px 20px 0 0;
  border-top:1px solid rgba(255,255,255,.2);
  transform:translateY(100%); transition:transform .3s cubic-bezier(.4,0,.2,1);
  overflow:hidden; padding-bottom:env(safe-area-inset-bottom);
}
.kp-overlay.open .kp-sheet { transform:translateY(0); }
.kp-handle { width:36px; height:4px; background:rgba(255,255,255,.3); border-radius:2px; margin:10px auto 6px; }
.kp-top { display:flex; justify-content:space-between; align-items:center; padding:0 16px 8px; }
.kp-top-lbl { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.65); }
.kp-x { font-size:20px; color:rgba(255,255,255,.5); cursor:pointer; padding:4px 8px; }

/* Keypad display boxes */
.kp-displays { display:flex; gap:10px; padding:0 16px 10px; }
.kp-box { flex:1; background:rgba(0,0,0,.25); border-radius:12px; padding:10px 12px; border:1.5px solid transparent; cursor:pointer; }
.kp-box.active { background:rgba(255,255,255,.18); border-color:rgba(255,255,255,.6); }
.kp-box-lbl { font-size:9px; text-transform:uppercase; letter-spacing:.07em; color:rgba(255,255,255,.6); margin-bottom:3px; }
.kp-box-val { font-family:'DM Mono',monospace; font-size:28px; font-weight:500; color:#fff; line-height:1; min-height:34px; }
.kp-box-sub { font-size:11px; color:rgba(255,255,255,.55); margin-top:3px; }

/* Description row inside keypad */
.kp-desc-row { padding:0 16px 10px; }
.kp-desc-input {
  width:100%; background:rgba(0,0,0,.2); border:1.5px solid rgba(255,255,255,.2);
  color:#fff; padding:9px 13px; border-radius:10px;
  font-size:13px; font-family:'Syne',sans-serif; outline:none;
}
.kp-desc-input::placeholder { color:rgba(255,255,255,.4); }
.kp-desc-input:focus { border-color:rgba(255,255,255,.5); }

/* Code selector pills */
.kp-code-row { display:flex; gap:8px; padding:0 16px 10px; }
.kp-code-pill {
  flex:1; text-align:center; padding:7px 0;
  border-radius:8px; font-size:12px; font-weight:700;
  cursor:pointer; border:1.5px solid rgba(255,255,255,.2);
  color:rgba(255,255,255,.55); transition:all .15s;
  font-family:'DM Mono',monospace;
}
.kp-code-pill.sel { color:#fff; border-color:rgba(255,255,255,.7); }
.kp-code-pill.sel.b310 { background:#1e40af; border-color:#3b82f6; }
.kp-code-pill.sel.b320 { background:#065f46; border-color:#10b981; }
.kp-code-pill.sel.b331 { background:#92400e; border-color:#f59e0b; }
.kp-code-pill.sel.bite { background:#991b1b; border-color:#ef4444; }

/* Date row in keypad */
.kp-date-row { display:flex; align-items:center; justify-content:space-between; padding:0 16px 10px; }
.kp-date-lbl { font-size:12px; font-family:'DM Mono',monospace; color:#fff; }
.kp-date-btn { background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3); color:#fff; border-radius:8px; padding:5px 12px; font-size:11px; font-weight:700; cursor:pointer; }

/* Keypad grid */
.kp-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:rgba(0,0,0,.3); border-top:1px solid rgba(255,255,255,.1); }
.kp-key { background:rgba(255,255,255,.07); padding:16px 0; text-align:center; font-size:22px; font-weight:600; color:#fff; cursor:pointer; user-select:none; display:flex; flex-direction:column; align-items:center; justify-content:center; transition:background .1s; }
.kp-key:active, .kp-key:hover { background:rgba(255,255,255,.15); }
.kp-key .ksub { font-size:8px; color:rgba(255,255,255,.4); margin-top:1px; }
.kp-key.dark { background:rgba(0,0,0,.15); }
.kp-confirm { grid-column:span 3; background:var(--yellow); color:var(--blue-deep); padding:15px; font-size:15px; font-weight:800; font-family:'Syne',sans-serif; border:none; cursor:pointer; letter-spacing:.04em; }
.kp-confirm:hover { background:var(--yellow-dk); }

/* Employee keypad: sign toggle */
.kp-sign-row { display:flex; gap:10px; padding:0 16px 10px; }
.kp-sign-btn { flex:1; padding:9px 0; text-align:center; border-radius:10px; font-size:14px; font-weight:800; cursor:pointer; border:1.5px solid transparent; transition:all .15s; font-family:'Syne',sans-serif; }
.kp-sign-btn.pos { background:#dcfce7; color:#14532d; border-color:#86efac; }
.kp-sign-btn.neg { background:#fee2e2; color:#7c2d12; border-color:#fca5a5; }

/* ─── MODAL (text entry) ─── */
.modal-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,.5);
  z-index:500; display:flex; align-items:center; justify-content:center;
  opacity:0; pointer-events:none; transition:opacity .2s;
}
.modal-overlay.open { opacity:1; pointer-events:all; }
.modal-box {
  background:#fff; border-radius:18px; padding:24px;
  width:440px; max-width:95vw;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
  transform:scale(.95); transition:transform .2s;
}
.modal-overlay.open .modal-box { transform:scale(1); }
.modal-title { font-size:16px; font-weight:800; color:var(--text1); margin-bottom:18px; }
.modal-field { margin-bottom:14px; }
.modal-lbl { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--text3); margin-bottom:5px; }
.modal-input {
  width:100%; background:#f4f6f9; border:1.5px solid var(--gray-bdr);
  color:var(--text1); padding:10px 13px; border-radius:10px;
  font-size:14px; font-family:'Syne',sans-serif; outline:none;
}
.modal-input:focus { border-color:var(--blue); background:#fff; }
.modal-btns { display:flex; gap:10px; justify-content:flex-end; margin-top:18px; }

/* Calendar in modal */
.mini-cal { margin-top:8px; }
.mini-cal-nav { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.mini-cal-nav button { background:rgba(0,0,0,.06); border:none; border-radius:6px; padding:4px 10px; font-size:14px; cursor:pointer; }
.mini-cal-lbl { font-size:13px; font-weight:700; }
.mini-cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:2px; }
.mini-cal-dow { text-align:center; font-size:9px; font-weight:700; color:var(--text3); padding:3px 0; text-transform:uppercase; }
.mini-cal-day { text-align:center; padding:6px 0; font-size:12px; font-family:'DM Mono',monospace; border-radius:6px; cursor:pointer; }
.mini-cal-day:hover { background:rgba(0,119,182,.1); }
.mini-cal-day.today { background:rgba(0,119,182,.15); font-weight:700; }
.mini-cal-day.sel { background:var(--blue); color:#fff; font-weight:700; }
.mini-cal-day.empty { cursor:default; }

/* ─── TOAST ─── */
.toast {
  position:fixed; bottom:32px; left:50%;
  transform:translateX(-50%) translateY(20px);
  background:#0d1b2a; color:#fff; border-radius:12px;
  padding:10px 22px; font-size:12px; font-weight:600;
  box-shadow:0 8px 24px rgba(0,0,0,.4);
  z-index:999; opacity:0; transition:all .3s;
  pointer-events:none; white-space:nowrap;
}
.toast.show { opacity:1; transform:translateX(-50%) translateY(0); }

/* ─── RECONCILE ─── */
.rec-row { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:14px; }
.rec-field { display:flex; flex-direction:column; gap:5px; }
.rec-lbl { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--text3); }
.rec-val { background:#f4f6f9; border:1.5px solid var(--gray-bdr); border-radius:10px; padding:9px 13px; font-size:13px; font-family:'DM Mono',monospace; color:var(--text1); cursor:pointer; }
.rec-val:hover { border-color:var(--blue); background:#fff; }
.rec-result { padding:14px 16px; border-radius:10px; font-size:13px; }
.rec-result.match   { background:#d1fae5; border:1px solid #6ee7b7; color:#065f46; }
.rec-result.nomatch { background:#fee2e2; border:1px solid #fca5a5; color:#7c2d12; }

/* ─── STATUS CHIP ─── */
.status-active { font-size:11px; font-weight:700; color:var(--green); }
.status-term   { font-size:11px; color:var(--text3); }
</style>
</head>
<body>

<!-- ═══ HEADER ═══ -->
<div class="hdr">
  <div class="hdr-left">
    <div class="hdr-logo">SDP</div>
    <div>
      <div class="hdr-title">SDSEP Budget Tracker</div>
      <div class="hdr-sub">Ryan Nguyen · Harbor Regional Center · 12/1/25–11/30/26</div>
    </div>
  </div>
  <div class="hdr-right">
    <div class="sync-pill wait" id="sync-pill">Connecting…</div>
    <button class="hdr-btn" onclick="toggleDotsMenu(event)">···</button>
    <!-- Dots menu -->
    <div id="dots-menu" style="display:none;position:absolute;top:58px;right:28px;background:#fff;border:1px solid var(--gray-bdr);border-radius:14px;padding:6px;z-index:200;box-shadow:0 8px 32px rgba(0,0,0,.15);min-width:180px;">
      <div onclick="exportData()" style="padding:11px 14px;font-size:13px;font-weight:700;color:var(--text1);cursor:pointer;border-radius:9px;display:flex;align-items:center;gap:10px;">⬆ Export Backup</div>
      <div onclick="document.getElementById('import-input').click()" style="padding:11px 14px;font-size:13px;font-weight:700;color:var(--text1);cursor:pointer;border-radius:9px;display:flex;align-items:center;gap:10px;">⬇ Import Backup</div>
      <input type="file" id="import-input" accept=".json" style="display:none" onchange="importData(event)">
    </div>
  </div>
</div>

<!-- ═══ TABS ═══ -->
