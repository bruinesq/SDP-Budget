function runReconcile() {
  const pid = document.getElementById('rec-period').value;
  const pp  = periods.find(p=>p.id===pid);
  if(!pp) { showToast('Please select a pay period.'); return; }

  const stmtCor   = recVals['cor']   || 0;
  const stmtMav   = recVals['mav']   || 0;
  const stmtRaf   = recVals['raf']   || 0;
  const stmtTax   = recVals['tax']   || 0;
  const stmtNs    = recVals['ns']    || 0;
  const stmtTotal = recVals['total'] || 0;

  const ourGross  = pp.gross || 0;
  const ourTax    = pp.tax   || 0;
  const ourTotal  = ourGross + ourTax;
  const stmtComp  = stmtCor + stmtMav + stmtRaf + stmtTax + stmtNs;
  const diff      = Math.abs(stmtTotal - ourTotal);
  const match     = diff < 0.50;

  document.getElementById('rec-result-body').innerHTML = `
    <div class="rec-result ${match?'match':'nomatch'}" style="margin-bottom:14px;">
      ${match ? '✓ MATCH — within $0.50 tolerance' : '✗ MISMATCH — '+fmt(diff)+' difference'}
    </div>
    <div class="proj-item"><div class="proj-lbl">Our tracked total</div><div class="proj-val">${fmt(ourTotal)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Statement total</div><div class="proj-val">${fmt(stmtTotal)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Our gross labor</div><div class="proj-val">${fmt(ourGross)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Our employer tax</div><div class="proj-val">${fmt(ourTax)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Statement components</div><div class="proj-val">${fmt(stmtComp)}</div></div>
    <div class="proj-item"><div class="proj-lbl">Difference</div><div class="proj-val ${match?'green':'red'}">${fmt(diff)}</div></div>
  `;
}

