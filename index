function renderTimesheet() {
  const base = weekStart(TODAY);
  base.setDate(base.getDate() + tsWeekOffset*7);
  const days = Array.from({length:7},(_,i)=>{ const d=new Date(base); d.setDate(d.getDate()+i); return d; });
  const DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  document.getElementById('ts-week-label').textContent =
    'Week of '+DOW[0]+' '+MON[base.getMonth()]+' '+base.getDate();
  document.getElementById('ts-week-range').textContent =
    isoFromDate(days[0])+' → '+isoFromDate(days[6])+' · Sun–Sat · OT rules apply';

  // Build weekly hours for OT calc
  const empKeys = ['cor','mav','raf'];
  const weekHrs = {};
  empKeys.forEach(e=>{ weekHrs[e]=days.map(d=>{ const key=isoFromDate(d); return timesheet[key]?.(e)||0; }); });

  const rows = days.map((d,i)=>{
    const iso  = isoFromDate(d);
    const isToday = iso===todayStr();
    const empCells = empKeys.map(e=>{
      const hrs = timesheet[iso]?.[e] || 0;
      const otWarn = hrs > 8 && hrs <= 12 ? ' style="color:var(--orange);font-weight:700;"' : hrs>12 ? ' style="color:var(--red);font-weight:700;"' : '';
      const label = hrs>0 ? hrs.toFixed(1)+' hrs'+(hrs>12?' ⚠2×':hrs>8?' ⚠OT':'') : '<span style="color:var(--text3);">—</span>';
      return `<td${otWarn} onclick="openTsKp('${iso}','${e}')" style="cursor:pointer;" class="mono">${label}</td>`;
    }).join('');
    const dailyTotal = empKeys.reduce((s,e)=>s+(timesheet[iso]?.[e]||0),0);
    const bg = isToday ? 'background:rgba(0,119,182,.05);' : '';
    return `<tr style="${bg}">
      <td style="font-weight:${isToday?'700':'400'};color:${isToday?'var(--blue)':'var(--text2)'};">
        ${DOW[i]} ${MON[d.getMonth()]} ${d.getDate()}${isToday?' <span style="font-size:10px;background:var(--blue);color:#fff;padding:1px 6px;border-radius:4px;margin-left:4px;">TODAY</span>':''}
      </td>
      ${empCells}
      <td class="mono" style="color:var(--text3);">${dailyTotal>0?dailyTotal.toFixed(1)+' hrs':'—'}</td>
    </tr>`;
  }).join('');
  document.getElementById('ts-tbody').innerHTML = rows;

  // Weekly summaries per employee
  empKeys.forEach(e=>{
    const dailyArr = weekHrs[e];
    const totHrs   = dailyArr.reduce((s,h)=>s+h,0);
    const rate     = getRate(e, isoFromDate(days[0]));
    let regH=0,ot15H=0,ot2H=0;
    dailyArr.forEach(h=>{
      regH  += Math.min(h,8);
      ot15H += Math.max(0,Math.min(h,12)-8);
      ot2H  += Math.max(0,h-12);
    });
    const gross = regH*rate.reg + ot15H*rate.ot + ot2H*rate.ot2;
    const emp   = EMPLOYEES[e];
    const id    = 'ts-sum-'+e;
    document.getElementById(id).innerHTML = `
      <div style="font-size:13px;font-weight:700;color:var(--text1);margin-bottom:8px;">${emp.name}</div>
      <div style="display:flex;flex-direction:column;gap:5px;font-size:12px;font-family:'DM Mono',monospace;color:var(--text3);">
        <div style="display:flex;justify-content:space-between;"><span>Reg hrs</span><span style="color:var(--text1);">${regH.toFixed(1)}</span></div>
        <div style="display:flex;justify-content:space-between;"><span>OT 1.5× hrs</span><span style="color:${ot15H>0?'var(--orange)':'var(--text1)'};">${ot15H.toFixed(1)}</span></div>
        <div style="display:flex;justify-content:space-between;"><span>OT 2× hrs</span><span style="color:${ot2H>0?'var(--red)':'var(--text1)'};">${ot2H.toFixed(1)}</span></div>
        <div style="display:flex;justify-content:space-between;border-top:1px solid var(--gray-bdr);padding-top:5px;"><span>Total hrs</span><span style="color:var(--text1);font-weight:700;">${totHrs.toFixed(1)}</span></div>
        <div style="display:flex;justify-content:space-between;"><span>Est. gross</span><span style="color:var(--green);font-weight:700;">${fmt(gross)}</span></div>
      </div>`;
  });
}

